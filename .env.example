# --- Server ---
PORT=5000
NODE_ENV=development
API_VERSION=v1
FRONTEND_URL=http://localhost:5173

# --- Database ---
# TLS must be enforced on the connection string (Atlas does this by default via mongodb+srv://)
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/liko?retryWrites=true&w=majority&tls=true

# --- JWT ---
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Encryption / Envelope Key Management (interim: secrets manager, not raw KMS) ---
# KMS_KEY_ID / BLIND_INDEX_KEY_REF are REFERENCES the secrets manager resolves at boot.
# The actual key material must never be committed or logged. See src/config/kms.js.
KMS_PROVIDER=secrets-manager        # interim provider; swap to 'aws-kms' / 'gcp-kms' later without touching call sites
KMS_KEY_ID=liko/data-encryption-key
BLIND_INDEX_KEY_REF=liko/blind-index-key
# Local-dev-only fallback (NEVER set in staging/production — kms.js refuses to boot in production without a real provider)
DEV_MASTER_KEY_HEX=
DEV_BLIND_INDEX_KEY_HEX=

# --- MFA ---
MFA_ISSUER=Liko Security Training
# Toggleable per FR-AUTH-04 decision: MFA is enforceable per-account (mfaEnabled flag),
# not hardcoded mandatory for Super Admin yet. Flip ENFORCE_MFA_FOR_SUPER_ADMIN=true when ready.
ENFORCE_MFA_FOR_SUPER_ADMIN=false

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PRIVATE_FOLDER=liko/id-documents
CLOUDINARY_PUBLIC_FOLDER=liko/public

# --- Mailjet ---
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_SENDER_EMAIL=no-reply@likosecurity.co.za
MAILJET_SENDER_NAME=Liko Security Training

# --- Rate limiting ---
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_STRICT_WINDOW_MS=900000
RATE_LIMIT_STRICT_MAX=5

# --- Body size ---
JSON_BODY_LIMIT=1mb
